# Gemini（Agent Platform）を使う
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# 音声入力（Gemini Live）の on/off。既定は true
VOICE_INPUT_ENABLED=true
# 設定できる持ち時間の上限（分）
MAX_DURATION_MINUTES=5

# モデル（必要なときだけ変更）
# TEXT_MODEL=gemini-3.8-flash
# DIRECTOR_MODEL=gemini-3.5-flash-lite
# LIVE_MODEL=gemini-3.8-live
# LIVE_LOCATION=us-central1

# セッション: 未設定なら Agent Runtime（Agent Platform Sessions）。ローカルで手早く試すなら true
# USE_IN_MEMORY_SESSION=true
# Agent Runtime のリージョン（global は不可）
# GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-central1
# 添付ファイルを置く GCS バケット（未設定ならメモリ）
# LOGS_BUCKET_NAME=your-bucket
